  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "check:sdk-pin": "node ./scripts/check-expo-sdk.js",
    "postinstall": "node ./scripts/check-expo-sdk.js"
  },
